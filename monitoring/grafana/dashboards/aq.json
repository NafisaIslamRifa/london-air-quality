{
  "title": "London NO2 Forecaster",
  "uid": "aq-forecaster",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Forecast requests (total)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(aq_requests_total{endpoint=\"/forecast\"}) or vector(0)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Latest forecast NO2 (µg/m³)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aq_last_prediction_ugm3"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Model in use",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "textMode": "name",
        "colorMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aq_model_info",
          "legendFormat": "v{{version}} ({{source}})",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Average latency",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(aq_request_latency_seconds_sum{endpoint=\"/forecast\"}) / sum(aq_request_latency_seconds_count{endpoint=\"/forecast\"})"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Forecast requests per minute (by status)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(aq_requests_total{endpoint=\"/forecast\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency: p95 and average",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(aq_request_latency_seconds_bucket{endpoint=\"/forecast\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "sum(rate(aq_request_latency_seconds_sum{endpoint=\"/forecast\"}[5m])) / sum(rate(aq_request_latency_seconds_count{endpoint=\"/forecast\"}[5m]))",
          "legendFormat": "average"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latest forecast NO2 over time (µg/m³)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aq_last_prediction_ugm3",
          "legendFormat": "predicted"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Forecast success rate",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(aq_requests_total{endpoint=\"/forecast\",status=\"200\"}) or vector(0)) / sum(aq_requests_total{endpoint=\"/forecast\"})"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "API status",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"aq-api\"}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Errors per minute (non-200)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{status}}",
          "expr": "sum by (status) (increase(aq_requests_total{endpoint=\"/forecast\",status!=\"200\"}[1m]))"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "API memory",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "resident memory",
          "expr": "process_resident_memory_bytes{job=\"aq-api\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "API CPU (cores)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "cpu",
          "expr": "rate(process_cpu_seconds_total{job=\"aq-api\"}[1m])"
        }
      ]
    }
  ]
}