{
  "__inputs": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource",
                "pluginId": "prometheus", "pluginName": "Prometheus"}],
  "title": "London NO2 Forecaster (cloud)",
  "uid": "aq-cloud",
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-14d", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Predicted vs actual NO2 (evaluated days, ug/m3)",
     "gridPos": {"h": 9, "w": 16, "x": 0, "y": 0},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "fieldConfig": {"defaults": {"custom": {"lineInterpolation": "stepAfter", "showPoints": "always", "spanNulls": true}}, "overrides": []},
     "targets": [
       {"refId": "A", "legendFormat": "predicted", "expr": "last_over_time(aq_eval_predicted_no2_ugm3[26h])"},
       {"refId": "B", "legendFormat": "actual", "expr": "last_over_time(aq_eval_actual_no2_ugm3[26h])"}]},
    {"id": 2, "type": "stat", "title": "Rolling MAE (last 7 evaluated forecasts)",
     "gridPos": {"h": 9, "w": 4, "x": 16, "y": 0},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "fieldConfig": {"defaults": {"decimals": 2, "unit": "none"}, "overrides": []},
     "targets": [{"refId": "A", "expr": "last_over_time(aq_rolling_mae_7d_ugm3[26h])"}]},
    {"id": 3, "type": "stat", "title": "Evaluated forecasts in MAE window",
     "gridPos": {"h": 9, "w": 4, "x": 20, "y": 0},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "targets": [{"refId": "A", "expr": "last_over_time(aq_eval_count[26h])"}]},
    {"id": 4, "type": "stat", "title": "Drift indicator",
     "gridPos": {"h": 6, "w": 6, "x": 0, "y": 9},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {
        "0": {"text": "NO DRIFT", "color": "green"}, "1": {"text": "DRIFT", "color": "red"}}}]}, "overrides": []},
     "targets": [{"refId": "A", "expr": "last_over_time(aq_drift_flag[26h])"}]},
    {"id": 5, "type": "timeseries", "title": "Input shift vs same-month training (std units)",
     "gridPos": {"h": 6, "w": 18, "x": 6, "y": 9},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "fieldConfig": {"defaults": {"custom": {"lineInterpolation": "stepAfter", "showPoints": "always", "spanNulls": true}}, "overrides": []},
     "targets": [{"refId": "A", "legendFormat": "{{feature}}", "expr": "last_over_time(aq_drift_shift[26h])"}]},
    {"id": 6, "type": "timeseries", "title": "API latency and cold-start wake time (daily check)",
     "gridPos": {"h": 8, "w": 16, "x": 0, "y": 15},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineInterpolation": "stepAfter", "showPoints": "always", "spanNulls": true}}, "overrides": []},
     "targets": [
       {"refId": "A", "legendFormat": "forecast latency", "expr": "last_over_time(aq_api_latency_seconds[26h])"},
       {"refId": "B", "legendFormat": "wake time", "expr": "last_over_time(aq_api_wake_seconds[26h])"}]},
    {"id": 7, "type": "stat", "title": "API status (last check)",
     "gridPos": {"h": 4, "w": 4, "x": 16, "y": 15},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {
        "0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}, "overrides": []},
     "targets": [{"refId": "A", "expr": "last_over_time(aq_api_up[26h])"}]},
    {"id": 8, "type": "stat", "title": "Latest forecast NO2 (ug/m3)",
     "gridPos": {"h": 4, "w": 4, "x": 20, "y": 15},
     "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "fieldConfig": {"defaults": {"decimals": 1}, "overrides": []},
     "targets": [{"refId": "A", "expr": "last_over_time(aq_predicted_no2_ugm3[26h])"}]}
  ]
}